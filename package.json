{
  "name": "@gameroom/react",
  "version": "0.1.0",
  "description": "An embeddable 3D pixel-art game room for React \u2014 sprites, character selection, arcade easter eggs, admin controls and music.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/gameroom.js",
  "module": "./dist/gameroom.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/gameroom.js"
    },
    "./styles.css": "./dist/gameroom.css",
    "./hub": {
      "types": "./dist/server/hub.d.ts",
      "import": "./dist/server/hub.js"
    }
  },
  "files": [
    "dist",
    "public",
    "README.md",
    "ASSETS.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "concurrently -n app,hub -c cyan,magenta \"vite\" \"bun run server/hub-server.ts\"",
    "dev:app": "vite",
    "dev:hub": "bun run server/hub-server.ts",
    "build": "vite build",
    "build:lib": "vite build --config vite.lib.config.ts",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "smoke": "node scripts/smoke.mjs"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18",
    "three": ">=0.170.0"
  },
  "dependencies": {
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/press-start-2p": "^5.3.0",
    "@fontsource/vt323": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.0",
    "@types/bun": "^1.4.2",
    "@types/node": "^22.10.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/three": "^0.185.1",
    "@vitejs/plugin-react": "^6.0.1",
    "concurrently": "^9.1.0",
    "jsdom": "^29.1.1",
    "playwright": "^1.63.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.7.2",
    "vite": "^8.0.0",
    "vite-plugin-dts": "^4.5.4",
    "vitest": "^3.0.5"
  },
  "keywords": [
    "react",
    "three",
    "webgl",
    "pixel-art",
    "game-room",
    "multiplayer",
    "virtual-space",
    "sprites"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/whusein/gameroom.git"
  }
}
